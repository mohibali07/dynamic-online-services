{
    "name": "dynamic-online-services",
    "version": "1.1.2",
    "description": "A comprehensive WordPress plugin for managing Dynamic Online Services and their categories with advanced filtering and customizable styles",
    "private": true,
    "keywords": [
        "wordpress",
        "plugin",
        "courses",
        "services",
        "education",
        "gutenberg",
        "block-editor",
        "custom-post-type",
        "taxonomy"
    ],
    "homepage": "https://github.com/techmire-solutions/dynamic-online-services#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/techmire-solutions/dynamic-online-services"
    },
    "bugs": {
        "url": "https://github.com/techmire-solutions/dynamic-online-services/issues"
    },
    "author": "Techmire Solutions <info@techmiresolutions.com> (http://techmiresolutions.com/)",
    "license": "GPL-2.0-or-later",
    "engines": {
        "node": ">=14.0.0",
        "npm": ">=6.0.0"
    },
    "main": "build/index.js",
    "browserslist": [
        "extends @wordpress/browserslist-config"
    ],
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@wordpress/api-fetch": "^7.36.0",
        "@wordpress/components": "^30.9.0",
        "@wordpress/element": "^6.36.0",
        "@wordpress/i18n": "^6.9.0",
        "@wordpress/scripts": "^30.0.0"
    },
    "scripts": {
        "build": "wp-scripts build",
        "format": "wp-scripts format",
        "lint": "npm run lint:js && npm run lint:css && npm run lint:pkg-json",
        "lint:css": "wp-scripts lint-style",
        "lint:js": "wp-scripts lint-js",
        "lint:pkg-json": "wp-scripts lint-pkg-json",
        "lint:php": "composer lint",
        "lint:php:fix": "composer lint:fix",
        "packages-update": "wp-scripts packages-update",
        "plugin-zip": "wp-scripts plugin-zip",
        "start": "wp-scripts start",
        "test": "composer test",
        "test:all": "npm run test && npm run test:e2e",
        "test:coverage": "composer test:coverage",
        "test:e2e": "playwright test"
    }
}
