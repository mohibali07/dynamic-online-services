{
	"name": "techmire-solutions/dynamic-online-services",
	"description": "A custom plugin for managing Dynamic Online Services and their categories with a combined, sortable selection field and customizable styles.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Techmire Solutions",
			"homepage": "http://techmiresolutions.com/"
		}
	],
	"require": {},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"10up/wp_mock": "^1.1",
		"mockery/mockery": "^1.3",
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"test:coverage": "phpunit --coverage-html coverage"
	},
	"autoload": {
		"psr-4": {
			"TechmireSolutions\\DynamicOnlineServices\\": "includes/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
