{
    "name": "techmire-solutions/dynamic-online-services",
    "description": "A comprehensive WordPress plugin for managing Dynamic Online Services and their categories with a combined, sortable selection field, advanced filtering, and customizable styles.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "plugin",
        "courses",
        "services",
        "education",
        "custom-post-type",
        "gutenberg",
        "block-editor"
    ],
    "homepage": "https://github.com/techmire-solutions/dynamic-online-services",
    "authors": [
        {
            "name": "Techmire Solutions",
            "homepage": "http://techmiresolutions.com/",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/techmire-solutions/dynamic-online-services/issues",
        "source": "https://github.com/techmire-solutions/dynamic-online-services"
    },
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "10up/wp_mock": "^1.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.92",
        "mockery/mockery": "^1.6",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DynamicOnlineServices\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
