/**
 * Hero Section Styles
 * Mobile-First Design with RTL Support, Accessibility & Dark Mode
 */

/* ============================================
   CSS Custom Properties
   ============================================ */
:root {
	/* Default fallbacks if PHP variables are missing */
	--hero-overlay-color: #000;
	--hero-overlay-opacity: 0.5;
	--hero-text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
	--hero-text-shadow-light: 1px 1px 2px rgba(0, 0, 0, 0.5);
	--hero-content-bg: rgba(0, 0, 0, 0.3);
	--hero-content-radius: 10px;
	--hero-content-padding: 20px;
	--hero-margin-bottom: 30px;
	--hero-title-color: #fff;
	--hero-description-color: #fff;

	/* Typography Defaults */
	--hero-title-font-size-mobile: 2rem;
	--hero-title-font-size-tablet: 2.5rem;
	--hero-title-font-size: 3rem;

	--hero-description-font-size-mobile: 0.9rem;
	--hero-description-font-size-tablet: 1rem;
	--hero-description-font-size: 1.25rem;

	/* Layout Defaults */
	--hero-height-mobile: 30vh;
	--hero-height-tablet: 30vh;
	--hero-height: 50vh;

	--hero-border-radius: 10px;
}

/* Dark mode adjustments for better contrast */
@media (prefers-color-scheme: dark) {

	:root {
		--hero-overlay-opacity: 0.6;
		--hero-content-bg: rgba(0, 0, 0, 0.5);
	}
}

/* ============================================
   Container Layout
   ============================================ */
.category-hero-container {
	width: 100%;
	overflow: hidden;
	margin-block-end: var(--hero-margin-bottom);
	container-type: inline-size;
	container-name: hero-container;
	position: relative;
}

/* ============================================
   Hero Inner Section
   ============================================ */
.category-hero-inner {
	height: var(--hero-height-mobile);
	background-size: cover;
	background-position: center;
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
	text-align: center;
	contain: layout style paint;
}

/* Overlay for better text readability */
.category-hero-inner::before {
	content: "";
	position: absolute;
	inset: 0;
	opacity: var(--hero-overlay-opacity);
	z-index: 1;
	background-color: var(--hero-overlay-color);
	/* Optional: Blend mode if color is not black/white to look better */
	mix-blend-mode: multiply;
}

/* ============================================
   Hero Content
   ============================================ */
.hero-content {
	padding-block: var(--hero-content-padding);
	padding-inline: var(--hero-content-padding);
	position: relative;
	z-index: 2;
	border-radius: var(--hero-border-radius);
	background: var(--hero-content-bg);
	-webkit-backdrop-filter: blur(4px);
	backdrop-filter: blur(4px);
	max-width: 90%;
}

/* ============================================
   Hero Title
   ============================================ */
.category-hero-title {
	font-size: var(--hero-title-font-size-mobile);
	margin: 0;
	text-shadow: var(--hero-text-shadow);
	line-height: 1.2;
	color: var(--hero-title-color);
	font-weight: 700;
}

/* ============================================
   Hero Description
   ============================================ */
.hero-description {
	font-size: var(--hero-description-font-size-mobile);
	margin-block-start: 10px;
	margin-block-end: 0;
	margin-inline: 0;
	text-shadow: var(--hero-text-shadow-light);
	color: var(--hero-description-color);
	line-height: 1.5;
}

/* ============================================
   Text Alignment Modifiers
   ============================================ */
.hero-content--left {
	text-align: left;
}

.hero-content--center {
	text-align: center;
}

.hero-content--right {
	text-align: right;
}

/* ============================================
   Vertical Alignment Modifiers
   ============================================ */
.category-hero-inner--top {
	align-items: flex-start;
	padding-block-start: 40px;
}

.category-hero-inner--center {
	align-items: center;
}

.category-hero-inner--bottom {
	align-items: flex-end;
	padding-block-end: 40px;
}

/* ============================================
   Container Queries (Responsive Design)
   ============================================ */
@container hero-container (min-width: 480px) {
	.category-hero-inner {
		height: var(--hero-height-tablet);
	}

	.category-hero-title {
		font-size: var(--hero-title-font-size-tablet);
	}

	.hero-description {
		font-size: var(--hero-description-font-size-tablet);
	}

	.hero-content {
		max-width: 80%;
	}
}

@container hero-container (min-width: 768px) {

	.category-hero-inner {
		height: var(--hero-height);
	}

	.category-hero-title {
		font-size: var(--hero-title-font-size);
	}

	.hero-description {
		font-size: var(--hero-description-font-size);
	}

	.hero-content {
		max-width: 70%;
		padding-block: 30px;
		padding-inline: 40px;
	}
}

@container hero-container (min-width: 1024px) {

	/* Optional: Scaling up for very large screens */
	.category-hero-title {
		font-size: calc(var(--hero-title-font-size) * 1.1);
	}

	.hero-description {
		font-size: calc(var(--hero-description-font-size) * 1.1);
	}

	.hero-content {
		max-width: 60%;
	}
}

/* ============================================
   High Contrast Mode Support
   ============================================ */
@media (prefers-contrast: high) {

	.category-hero-inner::before {
		opacity: 0.8 !important;
		background-color: #000 !important;
	}

	.hero-content {
		background: rgba(0, 0, 0, 0.9);
		border: 2px solid #fff;
	}

	.category-hero-title,
	.hero-description {
		text-shadow: none;
		color: #fff !important;
	}
}

/* ============================================
   Accessibility - Reduced Motion
   ============================================ */
@media (prefers-reduced-motion: reduce) {

	.hero-content {
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	.category-hero-inner {
		transition: none !important;
	}
}

/* ============================================
   Accessibility - Focus Styles
   ============================================ */
.category-hero-inner a:focus-visible,
.hero-content a:focus-visible {
	outline: 3px solid #fff;
	outline-offset: 4px;
	border-radius: 4px;
}

/* ============================================
   Print Styles
   ============================================ */
@media print {

	.category-hero-container {
		margin-block-end: 15px;
	}

	.category-hero-inner {
		height: auto !important;
		min-height: 15vh;
		background: #f0f0f0 !important;
		page-break-inside: avoid;
	}

	.category-hero-inner::before {
		display: none;
	}

	.hero-content {
		background: transparent;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
		max-width: 100%;
		padding: 10px;
	}


	.category-hero-title,
	.hero-description {
		color: #000 !important;
		text-shadow: none !important;
	}

	.category-hero-title {
		font-size: 20pt !important;
	}

	.hero-description {
		font-size: 12pt !important;
	}
}

/* ============================================
   Responsive Images Support
   ============================================ */
@media (min-resolution: 2dppx) {

	/* High DPI displays - already handled by background-size: cover */
	.category-hero-inner {
		background-size: cover;
	}
}
