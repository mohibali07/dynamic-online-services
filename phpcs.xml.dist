<?xml version="1.0"?>
<ruleset name="Dynamic Online Services">
	<description>WordPress Coding Standards for Dynamic Online Services Plugin</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude patterns -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>

	<!-- Show progress and sniff codes -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Use basic WordPress rules without problematic dependencies -->
	<rule ref="WordPress.WP"/>
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.PHP"/>

	<!-- Minimum supported WordPress version -->
	<config name="minimum_supported_wp_version" value="6.9"/>

	<!-- Text domain check -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="dynamic-online-services"/>
			</property>
		</properties>
	</rule>

	<!-- Naming conventions - Accept dynos_ prefix and TechmireSolutions namespace -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="TechmireSolutions"/>
				<element value="dynos"/>
				<element value="DYNOS"/>
				<element value="DynamicOnlineServices"/>
			</property>
		</properties>
	</rule>

	<!-- Exclude file naming rules for PSR-4 autoloaded classes -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/includes/*</exclude-pattern>
		<exclude-pattern>*/cpt/*</exclude-pattern>
		<exclude-pattern>*/frontend/renderers/*</exclude-pattern>
		<exclude-pattern>*/frontend/shortcodes/*</exclude-pattern>
		<exclude-pattern>*/frontend/services/*</exclude-pattern>
		<exclude-pattern>*/admin/*</exclude-pattern>
	</rule>

	<!-- Disable deprecated POSIX sniff (use PHPCompatibility instead) -->
	<rule ref="WordPress.PHP.POSIXFunctions">
		<severity>0</severity>
	</rule>
</ruleset>
